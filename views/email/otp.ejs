<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Verification Code</title>
</head>
<body style="font-family: sans-serif; background-color: #f6f6f6; padding: 20px; margin: 0;">
<div style="background-color: #ffffff; padding: 25px; max-width: 450px; margin: 0 auto; border: 1px dashed #214d46; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.02);">
    <h2 style="color: #214d46; margin-top: 0; font-size: 22px; text-align: center;">Secure Verification Code</h2>
    <p style="color: #333333; font-size: 14px; line-height: 1.5; text-align: center;">
        Thank you for booking with GPH Luxury Hotel. Please use the following 6-digit confirmation code to authorize your payment.
    </p>
    <div style="background-color: #f3f4f6; padding: 16px; text-align: center; font-size: 28px; font-weight: bold; letter-spacing: 6px; color: #111827; border-radius: 8px; margin: 25px 0; border: 1px solid rgba(0,0,0,0.05);">
        <%= code %>
    </div>
    <p style="font-size: 12px; color: #9ca3af; text-align: center; margin-bottom: 0; line-height: 1.4;">
        This security code is valid for 5 minutes. If you did not initiate this transaction, please disregard this email.
    </p>
</div>
</body>
</html>
